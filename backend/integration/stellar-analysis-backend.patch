+/// Maximum failed delivery attempts, including the initial attempt.
+pub const MAX_WEBHOOK_ATTEMPTS: i32 = 3;
+const RETRY_BASE_SECONDS: i64 = 5;
+const RETRY_MAX_SECONDS: i64 = 300;
